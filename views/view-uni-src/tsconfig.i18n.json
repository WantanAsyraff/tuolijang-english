{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "allowJs": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "env.d.ts",
    "shime-uni.d.ts",
    "typings/**/*.d.ts",
    "locale/**/*.ts",
    "config/i18nTemplatePlugin.ts"
  ],
  "exclude": [
    "node_modules",
    "uni_modules",
    "unpackage",
    "**/*.vue.js"
  ]
}
