{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0.2",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "ext-pcntl": "*",
        "alipaysdk/easysdk": "^2.2",
        "aliyuncs/oss-sdk-php": "^2.4",
        "aws/aws-sdk-php": "^2.8",
        "box/spout": "^3.3",
        "casbin/laravel-authz": "^4.0",
        "crmeb/yihaotong": "^1.3",
        "defuse/php-encryption": "^2.3",
        "doctrine/dbal": "^3.10",
        "fastknife/ajcaptcha": "^2.1",
        "getuilaboratory/getui-pushapi-php-client-v2": "dev-master",
        "guzzlehttp/guzzle": "^7.8",
        "hhxsv5/laravel-s": "3.7.43",
        "intervention/image": "^2.7",
        "laravel/framework": "^9.52",
        "laravel/tinker": "^2.7",
        "league/mime-type-detection": "^1.15",
        "madnest/madzipper": "^1.3.2",
        "mews/captcha": "^3.3",
        "mochat/wework-finance-sdk": "^1.1",
        "obs/esdk-obs-php": "^3.24",
        "open-smf/connection-pool": "^1.0",
        "overtrue/pinyin": "^5.3",
        "phpoffice/phppresentation": "^1.2",
        "phpoffice/phpspreadsheet": "^2.1",
        "phpoffice/phpword": "^1.2",
        "predis/predis": "^2.0",
        "qcloud/cos-sdk-v5": "^2.5.6",
        "qcloud_sts/qcloud-sts-sdk": "^3.0",
        "qiniu/php-sdk": "^7.9",
        "spatie/laravel-route-attributes": "^1.20",
        "staudenmeir/laravel-adjacency-list": "^1.0",
        "swoole/ide-helper": "^4.6",
        "tymon/jwt-auth": "^2.1",
        "w7corp/easywechat": "^6.17",
        "webpatser/laravel-uuid": "^4.0",
        "xaboy/form-builder": "^2.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.13",
        "fakerphp/faker": "^1.9.1",
        "friendsofphp/php-cs-fixer": "^3.52",
        "kitloong/laravel-migrations-generator": "^6.0",
        "laravel/sail": "^1.16",
        "mockery/mockery": "^1.5",
        "nunomaduro/collision": "^6.4",
        "phpmd/phpmd": "^2.13",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^9.6",
        "spatie/laravel-ignition": "^1.6",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "crmeb\\": "crmeb/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Tuoluojiang\\Schedule\\": "packages/tuoluojiang/schedule/src/"
        },
        "files": [
            "app/Helpers/common.php"
        ],
        "exclude-from-classmap": [
            "database/seeders/v*/DataUpdateHandler.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": {
        "packagist": {
            "type": "composer",
            "url": "https://mirrors.cloud.tencent.com/composer/"
        }
    }
}
